  "provider": {
    "ollama": {
      "name": "Task-local guarded Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://127.0.0.1:1/v1",
      "options": {
        "baseURL": "http://127.0.0.1:1/v1",
        "apiKey": "local",
        "localRuntime": "ollama",
        "timeout": 260000,
        "connectTimeout": 260000,
        "idleTimeout": 60000
      },
      "models": {
        "openscience/qwen3-4b-ctx-16384": {
          "name": "openscience/qwen3-4b-ctx-16384",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "cost": {
            "input": 0,
            "output": 0
          },
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "mcp": {
    "caelab": {
      "type": "local",
      "enabled": true,
      "timeout": 120000,
      "command": [
        "C:\\Windows\\System32\\wsl.exe",
        "-d",
        "Ubuntu",
        "--cd",
        "/mnt/c/absolute/path/to/autonomous-cae-lab",
        "--",
        "/usr/bin/env",
        "CAELAB_STORE=/mnt/c/absolute/path/to/new-store",
        "/absolute/path/to/venv/bin/python",
        "/mnt/c/absolute/path/to/autonomous-cae-lab/openscience/mcp_server.py"
      ]
    }
  }
