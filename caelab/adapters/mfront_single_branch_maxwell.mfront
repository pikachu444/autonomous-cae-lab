// Trusted single-branch adaptation of TFEL5 GeneralizedMaxwell by Benoit Bary.
// Reference: thelfer/tfel commit85554f233306548d8c9c4d36af54b715c608b8c7,
// mfront/tests/behaviours/GeneralizedMaxwell.mfront.
// Adds an exact consistent tangent and reference-volume native energy hooks.
// TFEL/source/linking/corporate deployment approval remains UNKNOWN.
@DSL DefaultDSL;
@Includes{
  #include <cmath>
  #include <stdexcept>
}
@Behaviour SingleBranchMaxwell;
@Author Autonomous CAE Lab;
@Date 2026-09-30;
@Description{
  Synthetic infinitesimal isotropic standard linear solid, one Maxwell branch.
  Physical energy density is MPa = MJ/m^3 per reference volume.
  Prescribed piecewise-linear strain, positive fixed moduli and relaxation time.
}
@ModellingHypothesis Tridimensional;
@ProvidesTangentOperator;
@MaterialProperty real k0;
k0.setEntryName("EquilibriumBulkModulus");
@MaterialProperty real g0;
g0.setEntryName("EquilibriumShearModulus");
@MaterialProperty real k1;
k1.setEntryName("BranchBulkModulus");
@MaterialProperty real g1;
g1.setEntryName("BranchShearModulus");
@MaterialProperty real tau;
tau.setEntryName("RelaxationTime");
@StateVariable StressStensor q;
q.setEntryName("BranchStress");
@LocalVariable real deltaD;
@PredictionOperator{
  static_cast<void>(smt);
  if((dt<=0)||(k0<=0)||(g0<=0)||(k1<=0)||(g1<=0)||(tau<=0)||
     !std::isfinite(dt)||!std::isfinite(k0)||!std::isfinite(g0)||
     !std::isfinite(k1)||!std::isfinite(g1)||!std::isfinite(tau)){
    return false;
  }
  const real x=dt/tau;
  // Native zero-ratio transport is unsupported until denormal/driver proof.
  // Domain's bounded causal-history limit is distinct; never silently use f=0.
  if(!(x>0)||!std::isfinite(x)){return false;}
  real f;
  if(x<=1.0/8.0){
    const real c[] = {1.0/1.0, -1.0/2.0, 1.0/6.0, -1.0/24.0, 1.0/120.0, -1.0/720.0, 1.0/5040.0, -1.0/40320.0, 1.0/362880.0, -1.0/3628800.0, 1.0/39916800.0, -1.0/479001600.0, 1.0/6227020800.0, -1.0/87178291200.0, 1.0/1307674368000.0, -1.0/20922789888000.0, 1.0/355687428096000.0, -1.0/6402373705728000.0};
    f=c[17];
    for(int i=16;i>=0;--i){f=c[i]+x*f;}
  }else{f=-expm1(-x)/x;}
  const real k=k0+f*k1, g=g0+f*g1;
  if(!std::isfinite(f)||!std::isfinite(k)||!std::isfinite(g)){return false;}
  Dt=(k-2*g/3)*Stensor4::IxI()+2*g*Stensor4::Id();
}
@Integrator{
  if((dt<=0)||(k0<=0)||(g0<=0)||(k1<=0)||(g1<=0)||(tau<=0)||
     !std::isfinite(dt)||!std::isfinite(k0)||!std::isfinite(g0)||
     !std::isfinite(k1)||!std::isfinite(g1)||!std::isfinite(tau)){
    return FAILURE;
  }
  const real x=dt/tau;
  // Native zero-ratio transport is unsupported until denormal/driver proof.
  // Domain's bounded causal-history limit is distinct; never silently use f=0.
  if(!(x>0)||!std::isfinite(x)){return FAILURE;}
  const auto tr = [](const auto& v){
    real total=0, correction=0;
    for(unsigned short i=0;i<3;++i){
      const real t=total+v[i];
      correction += (std::abs(total)>=std::abs(v[i])) ? (total-t)+v[i] : (v[i]-t)+total;
      total=t;
    }
    return total+correction;
  };
  const auto dev = [](const auto& v){
    auto d=v;
    for(unsigned short i=0;i<3;++i){d[i]=((v[i]-v[(i+1)%3])+(v[i]-v[(i+2)%3]))/3;}
    return d;
  };
  const auto norm2 = [](const auto& v){
    real total=0, correction=0;
    for(unsigned short i=0;i<6;++i){
      const real a=v[i]*v[i], t=total+a;
      correction += (std::abs(total)>=std::abs(a)) ? (total-t)+a : (a-t)+total;
      total=t;
    }
    return total+correction;
  };
  const auto finite_tensor = [](const auto& v){
    for(unsigned short i=0;i<6;++i){if(!std::isfinite(v[i])){return false;}}
    return true;
  };
  real f;
  if(x<=1.0/8.0){
    const real c[] = {1.0/1.0, -1.0/2.0, 1.0/6.0, -1.0/24.0, 1.0/120.0, -1.0/720.0, 1.0/5040.0, -1.0/40320.0, 1.0/362880.0, -1.0/3628800.0, 1.0/39916800.0, -1.0/479001600.0, 1.0/6227020800.0, -1.0/87178291200.0, 1.0/1307674368000.0, -1.0/20922789888000.0, 1.0/355687428096000.0, -1.0/6402373705728000.0};
    f=c[17];
    for(int i=16;i>=0;--i){f=c[i]+x*f;}
  }else{f=-expm1(-x)/x;}
  real g, beta, delta;
  if(x<=1.0/8.0){
    const real gc[] = {1.0/2.0, -1.0/6.0, 1.0/24.0, -1.0/120.0, 1.0/720.0, -1.0/5040.0, 1.0/40320.0, -1.0/362880.0, 1.0/3628800.0, -1.0/39916800.0, 1.0/479001600.0, -1.0/6227020800.0, 1.0/87178291200.0, -1.0/1307674368000.0, 1.0/20922789888000.0, -1.0/355687428096000.0, 1.0/6402373705728000.0, -1.0/121645100408832000.0};
    g=gc[17];
    for(int i=16;i>=0;--i){g=gc[i]+x*g;}
    const real bc[] = {1.0/2.0,-1.0/24.0,1.0/240.0,-17.0/40320.0,31.0/725760.0,-691.0/159667200.0,5461.0/12454041600.0,-929569.0/20922789888000.0};
    const real dc[] = {1.0/12.0,-1.0/120.0,17.0/20160.0,-31.0/362880.0,691.0/79833600.0,-5461.0/6227020800.0,929569.0/10461394944000.0,-3202291.0/355687428096000.0};
    beta=bc[7];delta=dc[7];
    const real xx=x*x;
    for(int i=6;i>=0;--i){beta=bc[i]+xx*beta;delta=dc[i]+xx*delta;}
    delta*=x;
  }else{
    g=(1-f)/x;
    const real half=tanh(x/2);
    beta=half/x;delta=(x-2*half)/x/x;
  }
  const real a=exp(-x), A=-expm1(-2*x)/2;
  if(!std::isfinite(a)||!std::isfinite(A)||!std::isfinite(g)||
     !std::isfinite(beta)||!std::isfinite(delta)||!finite_tensor(q)||
     !finite_tensor(eto)||!finite_tensor(deto)){return FAILURE;}
  const StressStensor z=k1*tr(deto)*StrainStensor::Id()+2*g1*dev(deto);
  const StressStensor square=q+beta*z;
  const auto inv_quad = [&](const auto& v){
    const real t=tr(v);
    return t*t/(9*k1)+norm2(dev(v))/(2*g1);
  };
  deltaD=A*inv_quad(square)+delta*inv_quad(z);
  const StressStensor nextq=a*q+f*z;
  const StrainStensor endstrain=eto+deto;
  const StressStensor nextsig=k0*tr(endstrain)*StrainStensor::Id()+2*g0*dev(endstrain)+nextq;
  if(!std::isfinite(deltaD)||!finite_tensor(z)||!finite_tensor(square)||
     !finite_tensor(nextq)||!finite_tensor(nextsig)){return FAILURE;}
  q=nextq;sig=nextsig;
  if(computeTangentOperator_){
    const real k=k0+f*k1, mu=g0+f*g1;
    if(!std::isfinite(k)||!std::isfinite(mu)){return FAILURE;}
    Dt=(k-2*mu/3)*Stensor4::IxI()+2*mu*Stensor4::Id();
  }
}
@InternalEnergy{
  const auto tr = [](const auto& v){
    real total=0, correction=0;
    for(unsigned short i=0;i<3;++i){
      const real t=total+v[i];
      correction += (std::abs(total)>=std::abs(v[i])) ? (total-t)+v[i] : (v[i]-t)+total;
      total=t;
    }
    return total+correction;
  };
  const auto dev = [](const auto& v){
    auto d=v;
    for(unsigned short i=0;i<3;++i){d[i]=((v[i]-v[(i+1)%3])+(v[i]-v[(i+2)%3]))/3;}
    return d;
  };
  const auto norm2 = [](const auto& v){
    real total=0, correction=0;
    for(unsigned short i=0;i<6;++i){
      const real a=v[i]*v[i], t=total+a;
      correction += (std::abs(total)>=std::abs(a)) ? (total-t)+a : (a-t)+total;
      total=t;
    }
    return total+correction;
  };
  const auto finite_tensor = [](const auto& v){
    for(unsigned short i=0;i<6;++i){if(!std::isfinite(v[i])){return false;}}
    return true;
  };
  const StrainStensor e=eto+deto;
  if(!finite_tensor(e)||!finite_tensor(q)){throw std::runtime_error("Nonfinite native energy state");}
  const real te=tr(e), tq=tr(q);
  Psi_s=(k0*te*te+2*g0*norm2(dev(e))+tq*tq/(9*k1)+norm2(dev(q))/(2*g1))/2;
  if(!std::isfinite(Psi_s)){throw std::runtime_error("Nonrepresentable native stored energy");}
}
@DissipatedEnergy{
  Psi_d+=deltaD;
  if(!std::isfinite(Psi_d)){throw std::runtime_error("Nonrepresentable native dissipated energy");}
}
