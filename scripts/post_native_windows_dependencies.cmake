# Static PE diagnostics only. Does not load, copy, or change DLL search paths.
cmake_minimum_required(VERSION 3.20)
foreach(_input IN ITEMS POST_PVPYTHON POST_DUMPBIN)
  if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}")
    message(FATAL_ERROR "Missing diagnostic input: ${_input}")
  endif()
endforeach()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${POST_DUMPBIN}")
get_filename_component(_bin "${POST_PVPYTHON}" DIRECTORY)
file(TO_CMAKE_PATH "$ENV{SystemRoot}" _windows)
file(TO_CMAKE_PATH "$ENV{PATH}" _path)
set(_search "${_bin}" "${_windows}/System32" "${_windows}" "${CMAKE_CURRENT_BINARY_DIR}" ${_path})
list(REMOVE_DUPLICATES _search)
message(STATUS "POST_DEP_EXECUTABLE ${POST_PVPYTHON}")
message(STATUS "POST_DEP_TOOL ${POST_DUMPBIN}")
message(STATUS "POST_DEP_RULE CMake ${CMAKE_VERSION}: depending-file directory, System32, Windows, then listed DIRECTORIES; not full Windows loader precedence.")
message(STATUS "POST_DEP_LIMIT Static CMake PE resolution; Windows API sets, KnownDLLs, SxS and runtime LoadLibrary calls are not a loader trace.")
foreach(_directory IN LISTS _search)
  message(STATUS "POST_DEP_SEARCH ${_directory}")
endforeach()
# Show all existing CRT candidates, rather than assuming a DLL basename resolves.
foreach(_crt IN ITEMS vcruntime140.dll vcruntime140_1.dll msvcp140.dll)
  set(_found FALSE)
  foreach(_directory IN LISTS _search)
    set(_candidate "${_directory}/${_crt}")
    if(EXISTS "${_candidate}" AND NOT IS_DIRECTORY "${_candidate}")
      file(REAL_PATH "${_candidate}" _full)
      file(SHA256 "${_full}" _sha)
      message(STATUS "POST_DEP_CRT_CANDIDATE ${_crt} ${_full} SHA256=${_sha}")
      set(_found TRUE)
    endif()
  endforeach()
  if(NOT _found)
    message(STATUS "POST_DEP_CRT_NOT_FOUND ${_crt}")
  endif()
endforeach()
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES "${POST_PVPYTHON}"
  DIRECTORIES ${_search}
  RESOLVED_DEPENDENCIES_VAR _resolved
  UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflict)
foreach(_dependency IN LISTS _resolved)
  file(TO_CMAKE_PATH "${_dependency}" _full)
  string(TOLOWER "${_full}" _lower)
  string(TOLOWER "${_windows}/" _system_prefix)
  string(TOLOWER "${_bin}/" _runtime_prefix)
  string(FIND "${_lower}" "${_runtime_prefix}" _runtime_at)
  string(FIND "${_lower}" "${_system_prefix}" _system_at)
  if(_runtime_at EQUAL 0)
    set(_origin RUNTIME_BIN)
  elseif(_system_at EQUAL 0)
    set(_origin WINDOWS)
  else()
    set(_origin OTHER_SEARCH_PATH)
  endif()
  message(STATUS "POST_DEP_RESOLVED ${_origin} ${_full}")
endforeach()
foreach(_dependency IN LISTS _unresolved)
  string(TOLOWER "${_dependency}" _lower)
  if(_lower MATCHES "^(api-ms-|ext-ms-)")
    message(STATUS "POST_DEP_API_SET_UNRESOLVED ${_dependency} (virtual Windows contract; not proof of a missing physical DLL)")
  else()
    message(STATUS "POST_DEP_UNRESOLVED ${_dependency}")
  endif()
endforeach()
foreach(_name IN LISTS _conflict_FILENAMES)
  foreach(_candidate IN LISTS _conflict_${_name})
    message(STATUS "POST_DEP_CONFLICT ${_name} ${_candidate}")
  endforeach()
endforeach()
message(STATUS "POST_DEP_SCAN_COMPLETED (diagnostic only; pvpython load still decides the check)")
