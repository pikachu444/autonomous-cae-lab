@@ -1181,5 +1185,15 @@ void SpreadsheetView::handleHeaderDataChanged(Qt::Orientation orientation, int first, int last) {
 	if (orientation != Qt::Horizontal)
 		return;
+    // Mapping labels can change without a user resizing the raw table. Keep
+    // the source column width instead of shrinking it to a short numeric cell.
+    if (m_spreadsheet->property("caelab_source_view_order").toBool()) {
+        for (int index = first; index <= last; ++index) {
+            const auto width = m_spreadsheet->column(index)->width();
+            if (width > 0)
+                m_tableView->setColumnWidth(index, width);
+        }
+        return;
+    }
 
 	for (int index = first; index <= last; ++index)
