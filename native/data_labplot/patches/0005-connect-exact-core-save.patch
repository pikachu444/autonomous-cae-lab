diff --git a/src/frontend/spreadsheet/SpreadsheetHeaderView.cpp b/src/frontend/spreadsheet/SpreadsheetHeaderView.cpp
--- a/src/frontend/spreadsheet/SpreadsheetHeaderView.cpp
+++ b/src/frontend/spreadsheet/SpreadsheetHeaderView.cpp
@@ -17,2 +17,3 @@
 #include <QPainter>
+#include <QStyleOptionHeader>
 #include <QHelpEvent>
@@ -173,3 +174,17 @@ void SpreadsheetHeaderView::paintSection(QPainter* painter, const QRect& rect, int logicalIndex) const {
 	painter->save();
-	QHeaderView::paintSection(painter, master_rect, logicalIndex);
+    const auto caption = m_spreadsheet->column(logicalIndex)->property("caelab_source_header");
+    if (caption.isValid()) {
+        QStyleOptionHeader option;
+        initStyleOption(&option);
+        initStyleOptionForIndex(&option, logicalIndex);
+        option.rect = master_rect;
+        const auto lines = caption.toString().split(QLatin1Char('\n'));
+        // Elide the name separately: a long name must not consume the unit
+        // line. The model and tooltip retain the complete original captions.
+        option.text = fontMetrics().elidedText(lines.value(0), Qt::ElideRight, qMax(1, master_rect.width() - 12));
+        if (lines.size() > 1)
+            option.text += QLatin1Char('\n') + lines.mid(1).join(QLatin1Char('\n'));
+        style()->drawControl(QStyle::CE_Header, &option, painter, this);
+    } else
+        QHeaderView::paintSection(painter, master_rect, logicalIndex);
 	painter->restore();
