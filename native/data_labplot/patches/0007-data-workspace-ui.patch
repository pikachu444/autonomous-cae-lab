+QString dataColumnLabel(int column, const QString& original) {
+	switch (column) {
+	case 0: return QString::fromUtf8("이름");
+	case 1: return QString::fromUtf8("유형");
+	case 2: return QString::fromUtf8("생성일");
+	case 3: return QString::fromUtf8("메모");
+	case 4: return QString::fromUtf8("수정일");
+	default: return original;
+	}
+}
+
+// Override display text only; retain Qt's native header painting and model roles.
+class DataExplorerHeader final : public QHeaderView {
+public:
+	explicit DataExplorerHeader(QWidget* parent) : QHeaderView(Qt::Horizontal, parent) {}
+	void setDataWorkspaceMode(bool enabled) {
+		m_dataWorkspaceMode = enabled;
+		viewport()->update();
+	}
+protected:
+	void initStyleOptionForIndex(QStyleOptionHeader* option, int logicalIndex) const override {
+		QHeaderView::initStyleOptionForIndex(option, logicalIndex);
+		if (m_dataWorkspaceMode)
+			option->text = dataColumnLabel(logicalIndex, option->text);
+	}
+private:
+	bool m_dataWorkspaceMode{false};
+};
+}
 
