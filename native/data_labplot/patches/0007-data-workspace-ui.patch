+void ProjectExplorer::setDataWorkspaceMode(bool enabled) {
+	if (m_dataWorkspaceMode == enabled)
+		return;
+	if (enabled) {
+		m_regularVisibleColumns.clear();
+		for (int i = 0; i < list_showColumnActions.size(); ++i)
+			if (list_showColumnActions.at(i)->isChecked())
+				m_regularVisibleColumns.append(i);
+	}
+	m_dataWorkspaceMode = enabled;
+	static_cast<DataExplorerHeader*>(m_treeView->header())->setDataWorkspaceMode(enabled);
+	m_leFilter->setPlaceholderText(enabled ? QString::fromUtf8("이름 찾기") : i18n("Search/Filter"));
+	if (showAllColumnsAction)
+		showAllColumnsAction->setText(enabled ? QString::fromUtf8("모든 열 표시") : i18n("Show All"));
+	m_treeView->setObjectName(enabled ? QStringLiteral("caelabDataExplorerTree") : QString());
+	const auto visible = Settings::group(QStringLiteral("ProjectExplorer"))
+		.readEntry("DataWorkspaceVisibleColumns", QStringLiteral("0")).split(QLatin1Char(' '));
+	for (int i = 0; i < list_showColumnActions.size(); ++i) {
+		const bool checked = enabled ? (i == 0 || visible.contains(QString::number(i))) :
+			(m_regularVisibleColumns.isEmpty() ? i < 2 : m_regularVisibleColumns.contains(i));
+		const auto label = m_treeView->model()->headerData(i, Qt::Horizontal).toString();
+		list_showColumnActions.at(i)->setText(enabled ? dataColumnLabel(i, label) : label);
+		list_showColumnActions.at(i)->setEnabled(true);
+		list_showColumnActions.at(i)->setChecked(checked);
+		m_treeView->setColumnHidden(i, !checked);
+	}
+	m_treeView->header()->setStretchLastSection(!enabled);
+	if (m_treeView->model())
+		resizeHeader();
+}
+
+void ProjectExplorer::applyDataColumnVisibility() {
+	if (!m_dataWorkspaceMode || list_showColumnActions.isEmpty())
+		return;
+	int visible = 0;
+	for (int i = 0; i < list_showColumnActions.size(); ++i) {
+		auto* action = list_showColumnActions.at(i);
+		if (i == 0)
+			action->setChecked(true); // Name is the primary object identifier.
+		action->setEnabled(i != 0);
+		m_treeView->setColumnHidden(i, !action->isChecked());
+		visible += action->isChecked() ? 1 : 0;
+	}
+	showAllColumnsAction->setChecked(visible == list_showColumnActions.size());
+	showAllColumnsAction->setEnabled(visible != list_showColumnActions.size());
+}
+
+void ProjectExplorer::resizeDataNameColumn() {
+	if (!m_dataWorkspaceMode || !m_treeView->model())
+		return;
+	int remaining = m_treeView->viewport()->width();
+	for (int i = 1; i < m_treeView->model()->columnCount(); ++i)
+		if (!m_treeView->isColumnHidden(i))
+			remaining -= m_treeView->columnWidth(i);
+	// Optional metadata may scroll; it must never consume the object name.
+	m_treeView->setColumnWidth(0, qMax(180, remaining));
+}
+
+void ProjectExplorer::resizeEvent(QResizeEvent* event) {
+	QWidget::resizeEvent(event);
+	resizeDataNameColumn();
+}
+
 void ProjectExplorer::resizeHeader() {
+	if (m_dataWorkspaceMode) {
+		applyDataColumnVisibility();
+		auto* header = m_treeView->header();
+		header->setStretchLastSection(false);
+		header->setSectionResizeMode(QHeaderView::Interactive);
+		header->resizeSections(QHeaderView::ResizeToContents);
+		for (int i = 1; i < m_treeView->model()->columnCount(); ++i)
+			if (!m_treeView->isColumnHidden(i))
+				header->resizeSection(i, qBound(90, header->sectionSize(i), 220));
+		resizeDataNameColumn();
+		return;
+	}
 	m_treeView->header()->resizeSections(QHeaderView::ResizeToContents);
 	m_treeView->header()->resizeSection(0, m_treeView->header()->sectionSize(0) * 1.2); // make the column "Name" somewhat bigger
 }
