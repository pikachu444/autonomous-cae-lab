{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelab.local/schemas/campaign-plan/1.0",
  "title": "CAE-Lab reproducible DOE plan",
  "type": "object",
  "required": ["schema_version", "campaign_id", "study_id", "status", "backend", "model", "registry_revision", "registry_sha256", "core_source_sha256", "cad_adapter_version", "analysis_adapter_version", "variables", "algorithm", "samples", "analysis", "created_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,57}$"},
    "study_id": {"type": "string"},
    "status": {"const": "PLANNED"},
    "backend": {"type": "string"},
    "model": {"type": "string"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cad_adapter_version": {"type": "string"},
    "analysis_adapter_version": {"type": ["string", "null"]},
    "variables": {"type": "array", "minItems": 1},
    "algorithm": {"type": "object", "required": ["engine", "version", "seed"]},
    "samples": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"type": "object", "required": ["index", "values", "cad_experiment_id", "analysis_experiment_id"]}},
    "analysis": {"type": ["object", "null"]},
    "created_utc": {"type": "string"}
  },
  "additionalProperties": false
}
