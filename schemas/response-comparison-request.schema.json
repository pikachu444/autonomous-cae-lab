{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelab.local/schemas/response-comparison-request/1.0",
  "title": "Declared observation to recorded scalar response comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_id", "experiment_id", "purpose", "hypothesis", "observation", "response"],
  "properties": {
    "comparison_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "purpose": {"enum": ["DEFECT_REPRODUCTION", "JIG_FEASIBILITY"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "response": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["metric"],
          "properties": {
            "metric": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
            "component": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["history_channel", "sample_index"],
          "properties": {
            "history_channel": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
            "sample_index": {"type": "integer", "minimum": 0}}}
      ]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "source_kind", "source", "quantity", "component", "location", "coordinate_frame", "condition", "tolerance", "conditions"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"},
        "source_kind": {"enum": ["MEASURED_REPORTED", "SPECIFICATION", "SYNTHETIC"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "quantity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "component": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "location": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "coordinate_frame": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "condition": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "tolerance": {"type": "number", "minimum": 0},
        "axis": {"type": "object", "additionalProperties": false, "required": ["quantity", "value", "unit"],
          "properties": {"quantity": {"const": "time"}, "value": {"type": "number"}, "unit": {"const": "s"}}},
        "conditions": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "path", "value", "unit"],
            "properties": {
              "source": {"enum": ["execution", "input_parameters"]},
              "path": {"type": "array", "minItems": 1, "maxItems": 16,
                "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"}},
              "value": {"type": ["number", "string", "boolean"]},
              "unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"}
            }
          }
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"}}
}
