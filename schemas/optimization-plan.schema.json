{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelab.local/schemas/optimization-plan/1.0",
  "title": "CAE-Lab adaptive numerical optimization plan",
  "type": "object",
  "required": ["schema_version", "campaign_id", "study_id", "status", "backend", "model", "registry_revision", "registry_sha256", "core_source_sha256", "cad_adapter_version", "cad_source_fingerprint", "analysis_adapter_version", "variables", "algorithm", "objective", "constraints", "required_validations", "analysis", "failure_policy", "created_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,57}$"},
    "study_id": {"type": "string"}, "status": {"const": "PLANNED"},
    "backend": {"type": "string"}, "model": {"type": "string"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cad_adapter_version": {"type": "string"}, "analysis_adapter_version": {"type": ["string", "null"]},
    "cad_source_fingerprint": {"type": "object", "required": ["commit"]},
    "variables": {"type": "array", "minItems": 1},
    "algorithm": {"type": "object", "required": ["engine", "version", "seed", "initial_population", "max_generations", "population_size"]},
    "objective": {"type": "object", "required": ["source", "metric", "unit", "direction"]},
    "constraints": {"type": "array", "items": {"type": "object", "required": ["source", "metric", "unit", "operator", "limit", "scale"]}},
    "required_validations": {"type": "object", "required": ["cad", "analysis"]},
    "analysis": {"type": ["object", "null"]}, "failure_policy": {"type": "object"}, "created_utc": {"type": "string"}
  },
  "additionalProperties": false
}
