{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelab.local/schemas/result/1.0",
  "title": "CAE-Lab experiment result",
  "type": "object",
  "required": ["schema_version", "experiment_id", "study", "status", "decision", "solver_status", "converged", "cad_revision", "input_parameters", "metrics", "validations", "evidence", "artifacts", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string"}, "study": {"type": "object"},
    "status": {"enum": ["REJECTED", "COMPLETED_REVIEW_REQUIRED", "FAILED_EXECUTION"]},
    "decision": {"enum": ["NOT_RELEASED", "RELEASED"]},
    "solver_status": {"type": "string"}, "converged": {"type": ["boolean", "null"]},
    "cad_revision": {"type": ["string", "null"]}, "proposal_revision": {"type": "string"},
    "registry_revision": {"type": "integer"}, "input_parameters": {"type": "object"},
    "metrics": {"type": "object", "additionalProperties": {"type": "object", "required": ["value", "unit", "valid"], "properties": {"value": {}, "unit": {"type": "string"}, "valid": {"type": "boolean"}, "reason": {"type": "string"}}}},
    "validations": {"type": "array", "items": {"type": "object", "required": ["type", "validator", "status", "blocking", "evidence_ids", "timestamp"], "properties": {"status": {"enum": ["PASS", "FAIL", "UNKNOWN", "WARNING"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "type", "method", "observation", "source", "artifact"]}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "size_bytes", "revision"]}},
    "provenance": {"type": "object", "required": ["proposal_sha256", "registry_sha256", "source_commit", "adapter", "adapter_version", "created_utc"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
