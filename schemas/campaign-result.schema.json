{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelab.local/schemas/campaign-result/1.0",
  "title": "CAE-Lab completed DOE campaign",
  "type": "object",
  "required": ["schema_version", "campaign_id", "study_id", "status", "decision", "plan_sha256", "registry_sha256", "algorithm", "samples", "provenance", "completed_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string"},
    "study_id": {"type": "string"},
    "status": {"const": "COMPLETED_REVIEW_REQUIRED"},
    "decision": {"const": "NOT_RELEASED"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "algorithm": {"type": "object", "required": ["engine", "version", "seed"]},
    "samples": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["index", "values", "cad_experiment_id", "cad_result_sha256", "cad_status", "analysis_experiment_id", "analysis_result_sha256", "analysis_status", "metrics", "failures", "unknown", "decision"]}},
    "provenance": {"type": "object"},
    "completed_utc": {"type": "string"}
  },
  "additionalProperties": false
}
