  <diagram id="draft-run-evidence" name="편집·실행·저장·판정 구분">
    <mxGraphModel dx="1200" dy="780" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="780">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="편집 가능한 초안 → 명시 실행 → 보존 결과 → 별도 공학 판정" style="text;html=0;fontSize=24;fontFamily=Malgun Gothic;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1120" height="50" as="geometry"/></mxCell>
        <mxCell id="draft" value="사용자 편집&#10;셀 buffer / owner draft&#10;Undo/Redo · dirty · generation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF0F7;strokeColor=#59738E;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="gate" value="실행 전 해당 입력 검사&#10;단위·형상·참조·지원 capability&#10;유효 snapshot 고정" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF0F7;strokeColor=#59738E;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="345" y="130" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="job" value="사용자가 명시 실행&#10;새 run ID / store&#10;선택 attempt의 상태·취소·진단" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF0F7;strokeColor=#59738E;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="result" value="원 입력에 결과 보존&#10;완료 / 실패 / 취소 / 중단&#10;늦은 결과도 원 입력에 남김" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4F0;strokeColor=#507E6F;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="650" y="340" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="invalid" value="invalid 초안 유지·저장 가능&#10;원 편집값·진단을 보존&#10;필수 입력 invalid는 export/run 차단" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCEBE8;strokeColor=#B56658;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="345" y="340" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="save" value="사용자 저장 / 재열기&#10;원자료·정확한 참조·결과·개정 보존&#10;부분 실패: 이전 저장본·dirty 유지&#10;열기만으로 계산하지 않음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F8;strokeColor=#80909B;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="adopt" value="비교 / 명시 채택&#10;원 입력과 현재 입력·대상 개정 대조&#10;충돌: 보존 비교 / 재조회 / 분기 선택&#10;원 결과·입력 덮어쓰기 금지" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F8;strokeColor=#80909B;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="440" y="505" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="qualification" value="별도 공학 판정&#10;원 수치 허용치·측정·실패 유지&#10;UNKNOWN은 필요한 release 차단&#10;CI / exit 성공 / 전문가 합의 ≠ 승인" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#AA8D47;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="845" y="505" width="315" height="125" as="geometry"/></mxCell>
        <mxCell id="edit-gate" edge="1" parent="1" source="draft" target="gate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gate-job" edge="1" parent="1" source="gate" target="job" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontFamily=Malgun Gothic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gate-invalid" value="invalid" edge="1" parent="1" source="gate" target="invalid" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#B56658;fontFamily=Malgun Gothic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="invalid-edit" value="수정" edge="1" parent="1" source="invalid" target="draft" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#B56658;exitX=0;exitY=0.5;entryX=0.5;entryY=1;fontFamily=Malgun Gothic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="job-result" edge="1" parent="1" source="job" target="result" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="draft-save" edge="1" parent="1" source="draft" target="save" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="result-adopt" edge="1" parent="1" source="result" target="adopt" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="result-verdict" value="근거 전달" edge="1" parent="1" source="result" target="qualification" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontFamily=Malgun Gothic;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="adopt-save" edge="1" parent="1" source="adopt" target="save" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="notes" value="실행 실패는 원 기록으로 남기고 수정한 입력으로 새 실행한다. 창 닫기와 product job 취소는 별도다.&#10;이 도면은 현행 계약 경계이며 각 화면의 상세 조작·원격/부분 저장·취소 경합은 Pro 전체 명세에 연결한다." style="text;html=0;fontSize=14;fontFamily=Malgun Gothic;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="1120" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
