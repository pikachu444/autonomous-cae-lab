        <mxCell id="post" value="ParaView Post&#10;native pipeline · view · selection&#10;apps/desktop_post · external results" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF0F7;strokeColor=#59738E;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="840" y="135" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="common" value="같은 document / session / generation / saved revision / result / command&#10;기존 Workbench service · Client · CLI/Python · optional MCP 경로를 재사용&#10;Workbench 화면은 선택 사항 · CAD / AI / MCP는 해당 동작에 필요한 경우만 의존" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4F0;strokeColor=#507E6F;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="900" height="105" as="geometry"/></mxCell>
        <mxCell id="pre-common" edge="1" parent="1" source="pre" target="common" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#59738E;"><mxGeometry relative="1" as="geometry"/></mxCell>
