        <mxCell id="owners" value="기존 문서 소유자&#10;material_document / data_document&#10;pde_document / numerical_document&#10;simulation_document / study_document&#10;discussion_document / evaluation_definition&#10;기존 Qt 창·generation·Undo·저장 재사용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F8;strokeColor=#80909B;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="deterministic" value="기존 수치 / 작업 / adapter&#10;numerical engines → DOE/search 후보&#10;JobManager → 실행·취소·원 결과&#10;solver → physics&#10;Domain → 공학 규칙&#10;Adapter → native 문법·경로" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F4F6F8;strokeColor=#80909B;fontSize=15;fontFamily=Malgun Gothic;" vertex="1" parent="1"><mxGeometry x="430" y="465" width="340" height="160" as="geometry"/></mxCell>
